    },
    "body": {
      "name": "subscriber-c",
      "budget_mode": "cost_micros",
      "budget_limit": 36,
      "budget_period": "total"
    }
  },
  "response": {
    "status": 201,
    "body": {
      "id": "VK_C",
      "name": "subscriber-c",
      "created_at": "[ts]",
      "enabled": 1,
      "budget_mode": "cost_micros",
      "budget_limit": 36,
      "budget_period": "total",
      "key": "vk-[REDACTED]"
    }
  },
  "trace_events": [],
  "volatile": false,
  "notes": "Plaintext token shown once (redacted here); only its SHA-256 is stored server-side"
