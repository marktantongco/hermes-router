{
  "name": "golden_06_error_no_user",
  "description": "400 router_error when no user message present",
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {
      "Authorization": "Bearer golden-test-key-0001"
    },
    "body": {
      "model": "auto",
      "messages": [
        {
          "role": "system",
          "content": "You are helpful."
        }
      ],
      "stream": false
    }
  },
  "response": {
    "status": 400,
    "body": {
      "error": {
        "message": "No user message found in request",
        "type": "router_error"
      }
    }
  },
  "trace_events": [],
  "volatile": false,
  "notes": ""
}
